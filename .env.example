# NextAuth — gere um segredo longo (ex.: openssl rand -base64 32)
NEXTAUTH_SECRET="troque-este-segredo-em-producao-minimo-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Alias aceito por algumas versões / ferramentas
AUTH_SECRET="troque-este-segredo-em-producao-minimo-32-caracteres"
